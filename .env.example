# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler connection string used by the Supabase CLI for migrations.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# OPTIONAL AI assistant (Step 14). Leave unset to keep the assistant off; every
# question is then answered from stored data with no model call. It reads
# structured fields only, never tender documents.
# AI_ASSISTANT_API_KEY=
# AI_ASSISTANT_BASE_URL=https://api.openai.com/v1
# AI_ASSISTANT_MODEL=gpt-4o-mini
